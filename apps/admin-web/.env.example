CLIENT_KEY=evalley
API_BASE_URL=http://127.0.0.1:8000/api/v1/admin
API_TIMEOUT_MS=15000
ECOMMERCE_API_TOKEN=
CRM_API_BASE_URL=http://127.0.0.1:3100/api/v1
CRM_API_TOKEN=
CRM_API_EMAIL=
CRM_API_PASSWORD=
CRM_API_TENANT_SLUG=evalley-demo
AUTH_SESSION_SECRET=replace-with-at-least-32-random-characters
AUTH_MOCK_EMAIL=
AUTH_MOCK_PASSWORD=
AUTH_MODE=cookie

# --- Chat core module (support chat over the NestJS Chat API) ---
CHAT_API_BASE_URL=http://localhost:3001/api
# Option C (recommended): shared Chat API support account per client
CHAT_API_AGENT_EMAIL=
CHAT_API_AGENT_PASSWORD=
CHAT_API_AGENT_USERNAME=
CHAT_API_AUTO_REGISTER=true
# Option A (advanced): service-token endpoint
CHAT_API_SERVICE_KEY=
# Option B (advanced): local signing
CHAT_API_SHARED_JWT_SECRET=
CHAT_API_AGENT_USER_ID=
CHAT_API_TOKEN_TTL_S=900
NEXT_PUBLIC_CHAT_API_URL=http://localhost:3001/api
NEXT_PUBLIC_CHAT_SOCKET_URL=http://localhost:3001
