{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": [
        "CLIENT_KEY",
        "API_BASE_URL",
        "CRM_API_BASE_URL",
        "CRM_API_EMAIL",
        "CRM_API_PASSWORD",
        "CRM_API_TENANT_SLUG",
        "API_TIMEOUT_MS",
        "AUTH_SESSION_SECRET",
        "AUTH_MODE"
      ],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": ["*.tsbuildinfo"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    }
  }
}
